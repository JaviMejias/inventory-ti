# =============================================================================
# Inventory TI — API environment configuration
# =============================================================================
# Copy this file to .env in the repository root and adjust the values before
# starting the application. API development, tests, and admin bootstrap load
# this file automatically.
#
# All variables have safe development defaults. SESSION_SECRET must be
# overridden in production.
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_ti"

# Tests always create and drop their own disposable database. The connection
# user needs CREATEDB. Set TEST_DATABASE_URL only to use separate test credentials.
# TEST_DATABASE_URL="postgresql://test_runner:password@localhost:5432/postgres"

# ── Application ─────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV="development"

# API bind address and port
API_HOST="0.0.0.0"
API_PORT="3000"

# ── Authentication / sessions ───────────────────────────────────────────────
# Minimum 32 characters. REQUIRED in production — never commit this file
# with a real secret. Generate a random value before deploying.
# A dev fallback is used when NODE_ENV != production, but always set this.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Absolute session lifetime in hours (activity does not extend expiration)
SESSION_TTL_HOURS="8"

# ── Cookies ─────────────────────────────────────────────────────────────────
# Must be "true" in production (HTTPS). Set to "false" only for local dev.
COOKIE_SECURE="false"
# Use "none" with COOKIE_SECURE="true" for cross-site HTTPS requests;
# different origins are not necessarily different sites. Prefer one origin.
COOKIE_SAME_SITE="lax"

# ── CORS ────────────────────────────────────────────────────────────────────
# Origin the web application is served from. Used for CORS, not cookie domain.
WEB_ORIGIN="http://localhost:5173"

# Trust only known reverse proxies when deriving client IPs for rate limiting.
# loopback works with local Vite/ngrok; use false without a proxy, or explicit
# comma-separated IP addresses/CIDRs for deployed proxies. Never trust all hosts.
TRUST_PROXY="loopback"
