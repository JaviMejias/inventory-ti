{
  "name": "@inventory-ti/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx/esm src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "test": "node --env-file-if-exists=../../.env tests/run-tests.js",
    "typecheck": "tsc -b --pretty false",
    "prisma:generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate --schema ../../prisma/schema.prisma",
    "prisma:validate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js validate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy --schema ../../prisma/schema.prisma",
    "bootstrap:admin": "node --env-file-if-exists=../../.env --import tsx/esm src/scripts/bootstrap-admin.ts",
    "quarantine:test-users": "node --env-file-if-exists=../../.env --import tsx/esm src/scripts/quarantine-test-users.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.12.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2"
  }
}
