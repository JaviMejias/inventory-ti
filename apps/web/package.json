{
  "name": "@inventory-ti/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "test:errors": "node --test tests/api-errors.test.mjs",
    "test:corrections": "node --test tests/corrections.test.mjs",
    "test:toasts": "node --test tests/toast-lifecycle.test.mjs",
    "test:asset-status": "node --test tests/asset-status.test.mjs",
    "test:select": "node --test tests/select-position.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
