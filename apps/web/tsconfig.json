{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "skipLibCheck": true
  },
  "references": [{ "path": "../../packages/shared" }],
  "include": ["src", "vite.config.ts"]
}
