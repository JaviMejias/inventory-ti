# =============================================================================
# Inventory TI — Web application environment configuration
# =============================================================================
# Copy this file to .env inside apps/web/ and adjust as needed.
#
# These variables are compiled into the browser bundle at build time:
# only variables prefixed with VITE_ are exposed to the client.
# =============================================================================

# Base URL of the API as seen from the browser.
# - Local/ngrok development: /api (proxied by Vite to localhost:3000)
# - Production: the public https URL of the API
VITE_API_URL="/api"
